digraph G {
    // ==================================================
    // 全局布局
    // ==================================================
    graph [
        rankdir=TB,
        newrank=true,
        compound=true,
        splines=ortho,
        bgcolor="#F7F9FC",
        pad=0.45,
        margin=0.08,
        nodesep=0.52,
        ranksep=0.88,
        outputorder=edgesfirst,
        fontname="Microsoft YaHei",
        fontsize=12
    ];

    node [
        fontname="Microsoft YaHei",
        shape=box,
        style="rounded,filled",
        color="#90A4AE",
        fontcolor="#263238",
        fontsize=10,
        penwidth=1.15,
        margin="0.18,0.11",
        height=0.55
    ];

    edge [
        fontname="Microsoft YaHei",
        color="#AAB7BF",
        fontcolor="#78909C",
        fontsize=8,
        penwidth=1.15,
        arrowsize=0.68
    ];

    // ==================================================
    // 用户
    // ==================================================
    企业用户 [
        shape=ellipse,
        style="filled",
        fillcolor="#E8F5E9",
        color="#A5D6A7",
        fontsize=13,
        penwidth=1.4,
        width=1.65,
        height=0.62
    ];

    // ==================================================
    // 接入与路由层
    // ==================================================
    subgraph cluster_access {
        label="接入与路由层";
        labelloc="t";
        labeljust="c";

        color="#90CAF9";
        fillcolor="#F5FAFF";
        fontcolor="#1565C0";

        style="rounded,filled";
        penwidth=1.35;
        fontsize=13;
        margin=22;

        功能操作 [
            fillcolor="#BBDEFB",
            label="功能操作\n（手动）",
            width=1.72
        ];

        AI员工对话 [
            fillcolor="#BBDEFB",
            label="AI员工对话\n（自然语言）",
            width=1.82
        ];

        定时触发 [
            fillcolor="#BBDEFB",
            label="定时触发\n（策略驱动）",
            width=1.82
        ];

        {
            rank=same;
            功能操作;
            AI员工对话;
            定时触发;
        }

        // 固定层内左右顺序
        功能操作 -> AI员工对话 [
            style=invis,
            weight=80
        ];

        AI员工对话 -> 定时触发 [
            style=invis,
            weight=80
        ];
    }

    // ==================================================
    // 编排与调度层
    // ==================================================
    subgraph cluster_orchestration {
        label="编排与调度层";
        labelloc="t";
        labeljust="c";

        color="#FFCC80";
        fillcolor="#FFFBF5";
        fontcolor="#E65100";

        style="rounded,filled";
        penwidth=1.35;
        fontsize=13;
        margin=24;

        // -------------------- 记忆系统 --------------------
        subgraph cluster_memory {
            label="记忆系统";
            labelloc="t";
            labeljust="c";

            color="#FFE0B2";
            fillcolor="#FFFDF8";
            fontcolor="#F57C00";

            style="rounded,filled";
            penwidth=1.05;
            fontsize=10;
            margin=16;

            会话记忆 [
                fillcolor="#FFF8E1",
                label="会话记忆\n────────\n最近 N 轮原文\n＋历史摘要",
                width=1.9
            ];

            企业画像 [
                fillcolor="#FFF8E1",
                label="企业画像\n────────\n行业定位 · 偏好\n内容风格 · 禁忌",
                width=1.9
            ];

            {
                rank=same;
                会话记忆;
                企业画像;
            }

            会话记忆 -> 企业画像 [
                style=invis,
                weight=60
            ];
        }

        // -------------------- 规划中枢 --------------------
        规划Agent [
            shape=component,
            fillcolor="#FFE0B2",
            color="#F57C00",
            penwidth=1.45,
            fontsize=11,
            width=2.9,
            label="规划 Agent\n──────────────\n意图理解 · 风险预检\n任务拆解 · 能力编排\n调度 AI 员工执行"
        ];

        // -------------------- AI 员工 --------------------
        视频发布员 [
            fillcolor="#FFF3E0",
            label="视频发布员\n──────\n发起发布\n对接接口",
            width=1.62
        ];

        内容选题员 [
            fillcolor="#FFF3E0",
            label="内容选题员\n──────\n感知热点\n生成选题",
            width=1.62
        ];

        文案编导师 [
            fillcolor="#FFF3E0",
            label="文案编导师\n──────\n生成脚本\n爆款仿写",
            width=1.62
        ];

        视频剪辑师 [
            fillcolor="#FFF3E0",
            label="视频剪辑师\n──────\n驱动数字人\n模板 · 翻译",
            width=1.62
        ];

        {
            rank=same;
            视频发布员;
            内容选题员;
            文案编导师;
            视频剪辑师;
        }

        视频发布员 -> 内容选题员 [
            style=invis,
            weight=80
        ];

        内容选题员 -> 文案编导师 [
            style=invis,
            weight=80
        ];

        文案编导师 -> 视频剪辑师 [
            style=invis,
            weight=80
        ];
    }

    // ==================================================
    // 执行层
    // ==================================================
    subgraph cluster_execution {
        label="执行层（Workflow 固定链路 · AIGC 嵌入 · 内置审核）";
        labelloc="t";
        labeljust="c";

        color="#A5D6A7";
        fillcolor="#F7FCF8";
        fontcolor="#2E7D32";

        style="rounded,filled";
        penwidth=1.35;
        fontsize=13;
        margin=25;

        // -------------------- 选题 Workflow --------------------
        subgraph cluster_wf_topic {
            label="选题创作 Workflow";
            labelloc="t";
            labeljust="c";

            color="#C8E6C9";
            fillcolor="#FCFFFC";
            fontcolor="#388E3C";

            style="rounded,filled";
            penwidth=1.05;
            fontsize=10;
            margin=17;

            选题创作 [
                fillcolor="#E8F5E9",
                label="选题创作\n（工具）",
                width=2.15
            ];

            选题生成 [
                fillcolor="#C8E6C9",
                label="选题分析与策略\n────────────\n▶ AIGC：选题生成\n● 内置审核",
                width=2.15
            ];

            选题输出 [
                fillcolor="#E8F5E9",
                label="选题清单输出",
                width=2.15
            ];

            选题创作 -> 选题生成;
            选题生成 -> 选题输出;
        }

        // -------------------- 文案 Workflow --------------------
        subgraph cluster_wf_copy {
            label="文案创作 Workflow";
            labelloc="t";
            labeljust="c";

            color="#C8E6C9";
            fillcolor="#FCFFFC";
            fontcolor="#388E3C";

            style="rounded,filled";
            penwidth=1.05;
            fontsize=10;
            margin=17;

            文案创作 [
                fillcolor="#E8F5E9",
                label="文案创作\n（工具）",
                width=2.15
            ];

            文案生成 [
                fillcolor="#C8E6C9",
                label="脚本生成与风格适配\n────────────\n▶ AIGC：文案生成\n● 内置审核",
                width=2.15
            ];

            文案输出 [
                fillcolor="#E8F5E9",
                label="文案定稿输出",
                width=2.15
            ];

            文案创作 -> 文案生成;
            文案生成 -> 文案输出;
        }

        // -------------------- 视频 Workflow --------------------
        subgraph cluster_wf_video {
            label="视频创作 Workflow";
            labelloc="t";
            labeljust="c";

            color="#C8E6C9";
            fillcolor="#FCFFFC";
            fontcolor="#388E3C";

            style="rounded,filled";
            penwidth=1.05;
            fontsize=10;
            margin=17;

            视频创作 [
                fillcolor="#E8F5E9",
                label="视频创作\n（工具）",
                width=2.15
            ];

            视频生成 [
                fillcolor="#C8E6C9",
                label="脚本驱动视频生成\n────────────\n▶ AIGC：视频生成\n（数字人 · 音色克隆）\n● 内置审核",
                width=2.15
            ];

            视频输出 [
                fillcolor="#E8F5E9",
                label="成品视频输出",
                width=2.15
            ];

            视频创作 -> 视频生成;
            视频生成 -> 视频输出;
        }

        // 三个 Workflow 横向对齐
        {
            rank=same;
            选题创作;
            文案创作;
            视频创作;
        }

        {
            rank=same;
            选题生成;
            文案生成;
            视频生成;
        }

        {
            rank=same;
            选题输出;
            文案输出;
            视频输出;
        }

        // 固定三列左右顺序
        选题创作 -> 文案创作 [
            style=invis,
            weight=100
        ];

        文案创作 -> 视频创作 [
            style=invis,
            weight=100
        ];

        选题生成 -> 文案生成 [
            style=invis,
            weight=100
        ];

        文案生成 -> 视频生成 [
            style=invis,
            weight=100
        ];

        选题输出 -> 文案输出 [
            style=invis,
            weight=100
        ];

        文案输出 -> 视频输出 [
            style=invis,
            weight=100
        ];
    }

    // ==================================================
    // 安全与交付层
    // ==================================================
    subgraph cluster_delivery {
        label="安全与交付层";
        labelloc="t";
        labeljust="c";

        color="#CE93D8";
        fillcolor="#FCF8FD";
        fontcolor="#7B1FA2";

        style="rounded,filled";
        penwidth=1.35;
        fontsize=13;
        margin=24;

        结果组装 [
            fillcolor="#F3E5F5",
            label="结果组装\n────────\n拼装子结果\n统一交付卡片",
            width=2.05
        ];

        确认卡 [
            fillcolor="#EDE7F6",
            shape=note,
            color="#9575CD",
            penwidth=1.35,
            label="确认卡\n──────\n发布前\n人工确认",
            width=1.65
        ];

        平台发布接口 [
            fillcolor="#EDE7F6",
            label="平台发布接口\n──────────\n对接公域 · 私域\n状态管理 · 回执",
            width=2.15
        ];

        记忆写入 [
            fillcolor="#F3E5F5",
            label="记忆写入\n────────\n追加会话记忆\n更新企业画像\n抽取偏好信号",
            width=2.15
        ];

        {
            rank=same;
            结果组装;
            确认卡;
            平台发布接口;
        }

        结果组装 -> 确认卡 [
            weight=40
        ];

        确认卡 -> 平台发布接口 [
            weight=40
        ];
    }

    // ==================================================
    // 外部平台
    // ==================================================
    公域平台 [
        fillcolor="#F5F5F5",
        label="公域平台\n（抖音等）",
        width=1.9
    ];

    私域渠道 [
        fillcolor="#F5F5F5",
        label="私域渠道",
        width=1.9
    ];

    {
        rank=same;
        公域平台;
        私域渠道;
    }

    公域平台 -> 私域渠道 [
        style=invis,
        weight=80
    ];

    // ==================================================
    // 效果回流
    // ==================================================
    效果回流 [
        fillcolor="#ECEFF1",
        color="#B0BEC5",
        penwidth=1.25,
        width=4.25,
        label="效果回流与优化\n──────────────\n回流播放量 · 互动 · 转化数据\n驱动选题策略 · 文案风格迭代\n沉淀 Bad Case → 评测集"
    ];

    // ==================================================
    // 接入汇合点
    // ==================================================
    汇合点 [
        shape=point,
        width=0.05,
        height=0.05,
        label="",
        style=invis
    ];

    // ==================================================
    // 主体数据流
    // ==================================================

    // 用户 → 接入层
    企业用户:s -> AI员工对话:n [
        weight=25
    ];

    企业用户:s -> 功能操作:n;
    企业用户:s -> 定时触发:n;

    // 功能操作和定时触发汇合
    功能操作:s -> 汇合点:n [
        weight=8
    ];

    定时触发:s -> 汇合点:n [
        weight=8
    ];

    // 汇合后进入执行层
    汇合点:s -> 选题创作:n [
        lhead=cluster_execution,
        minlen=2
    ];

    // 自然语言入口 → 规划 Agent
    AI员工对话:s -> 规划Agent:n [
        lhead=cluster_orchestration,
        color="#78909C",
        penwidth=1.3,
        weight=30
    ];

    // 记忆系统 → 规划 Agent
    会话记忆:s -> 规划Agent:n [
        style=dashed,
        color="#FF9800",
        penwidth=1.2
    ];

    企业画像:s -> 规划Agent:n [
        style=dashed,
        color="#FF9800",
        penwidth=1.2
    ];

    // 规划 Agent → AI 员工
    规划Agent:s -> 视频发布员:n;
    规划Agent:s -> 内容选题员:n;
    规划Agent:s -> 文案编导师:n;
    规划Agent:s -> 视频剪辑师:n;

    // AI 员工 → 对应 Workflow
    内容选题员:s -> 选题创作:n [
        lhead=cluster_wf_topic
    ];

    文案编导师:s -> 文案创作:n [
        lhead=cluster_wf_copy
    ];

    视频剪辑师:s -> 视频创作:n [
        lhead=cluster_wf_video
    ];

    // 发布请求 → 结果组装
    视频发布员:s -> 结果组装:n [
        lhead=cluster_delivery,
        minlen=2
    ];

    // Workflow 产出 → 结果组装
    选题输出:s -> 结果组装:n;
    文案输出:s -> 结果组装:n;
    视频输出:s -> 结果组装:n;

    // 确认后写入记忆
    确认卡:s -> 记忆写入:n [
        style=dashed,
        color="#7B1FA2",
        penwidth=1.2,
        minlen=2
    ];

    // 发布接口 → 外部平台
    平台发布接口:s -> 公域平台:n [
        minlen=2
    ];

    平台发布接口:s -> 私域渠道:n [
        minlen=2
    ];

    // 外部平台 → 效果回流
    公域平台:s -> 效果回流:n [
        style=dashed,
        color="#78909C",
        penwidth=1.15
    ];

    私域渠道:s -> 效果回流:n [
        style=dashed,
        color="#78909C",
        penwidth=1.15
    ];

    // ==================================================
    // 主轴辅助布局
    // 只影响位置，不显示连线
    // ==================================================
    企业用户 -> AI员工对话 [
        style=invis,
        weight=120
    ];

    AI员工对话 -> 规划Agent [
        style=invis,
        weight=120
    ];

    规划Agent -> 文案编导师 [
        style=invis,
        weight=110
    ];

    文案编导师 -> 文案创作 [
        style=invis,
        weight=110
    ];

    文案输出 -> 确认卡 [
        style=invis,
        weight=100
    ];

    确认卡 -> 记忆写入 [
        style=invis,
        weight=80
    ];

    平台发布接口 -> 私域渠道 [
        style=invis,
        weight=80
    ];

    私域渠道 -> 效果回流 [
        style=invis,
        weight=80
    ];
}